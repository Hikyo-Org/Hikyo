{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "hikyo-lab-data",
    "namespace": "hikyo-lab"
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "storageClassName": "local-path",
    "resources": {
      "requests": {
        "storage": "1Gi"
      }
    }
  }
}
