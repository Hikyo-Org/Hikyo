[Unit]
Description=Finite approved Hikyo evidence poll for %i
RequiresMountsFor=/srv/hikyo-evidence
After=network.target hikyo-evidence-sshd.service

[Service]
Type=oneshot
User=hk-p-%i
ExecStart=/usr/bin/python3 -I -B /opt/hikyo-evidence/poll-once.py %i
TimeoutStartSec=310
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/hikyo-evidence/spool-%i
MemoryMax=256M
TasksMax=8
