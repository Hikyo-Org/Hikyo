[Unit]
Description=Hikyo content-free TLS health for independent watchdog
RequiresMountsFor=/srv/hikyo-evidence
After=network.target

[Service]
User=hk-monitor
ExecStart=/usr/bin/python3 -I -B /opt/hikyo-evidence/health.py /srv/hikyo-evidence/monitor/health.json /etc/hikyo-evidence/health.crt /etc/hikyo-evidence/health.key
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=64M
TasksMax=8

[Install]
WantedBy=multi-user.target
