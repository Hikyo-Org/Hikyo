{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "database",
    "rootKey",
    "externalOrigin",
    "network",
    "upgrade"
  ],
  "properties": {
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "stateExistingClaim",
        "evidence",
        "targetManifestSHA256",
        "legacyWritersStopped"
      ],
      "properties": {
        "existingClaim": {
          "type": "string",
          "minLength": 1
        },
        "stateExistingClaim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "boolean"
        },
        "targetManifestSHA256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "legacyWritersStopped": {
          "type": "boolean"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:(RELEASE_IMAGE_DIGEST|[0-9a-f]{64})$"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "existingSecret",
        "tls"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "existingSecret",
            "key"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rootKey": {
      "type": "object",
      "required": [
        "existingSecret",
        "key"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "not": {
            "enum": [
              ".",
              ".."
            ]
          }
        }
      }
    },
    "externalOrigin": {
      "type": "string",
      "minLength": 1
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "allowedOrigins"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedOrigins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ha": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 5
    },
    "network": {
      "type": "object",
      "required": [
        "trustedProxyCIDRs",
        "allowPlaintextOrigin"
      ],
      "properties": {
        "trustedProxyCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowPlaintextOrigin": {
          "type": "boolean"
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "enrolled": {
          "type": "boolean"
        },
        "enrollmentID": {
          "type": "string"
        },
        "ownerInstanceID": {
          "type": "string"
        },
        "incarnation": {
          "type": "string"
        },
        "deploymentUID": {
          "type": "string"
        },
        "commandSecretUID": {
          "type": "string"
        },
        "responseSecretUID": {
          "type": "string"
        },
        "journalSecretUID": {
          "type": "string"
        },
        "leaseUID": {
          "type": "string"
        },
        "authorityPublicKey": {
          "type": "string"
        },
        "authorityExistingSecret": {
          "type": "string"
        },
        "authorityKey": {
          "type": "string"
        },
        "databaseSources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rootSources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "fileSources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "initialDatabaseSource": {
          "type": "string"
        },
        "initialRootSource": {
          "type": "string"
        },
        "initialUpgradeSource": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9-]{0,29}[a-z0-9])?)?$"
        },
        "upgradeSources": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([a-z0-9-]{0,29}[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bundle_directory",
              "state_directory",
              "evidence_directory",
              "ciphertext_path",
              "operator_public_key_file",
              "target_manifest_sha256",
              "legacy_writers_stopped"
            ],
            "properties": {
              "bundle_directory": {
                "type": "string",
                "pattern": "^/run/hikyo-upgrade/[^/\u0000-\u001f\u007f]+(/[^/\u0000-\u001f\u007f]+)*$",
                "not": {
                  "pattern": "/\\.{1,2}(/|$)"
                }
              },
              "state_directory": {
                "type": "string",
                "pattern": "^/var/lib/hikyo-upgrade/[^/\u0000-\u001f\u007f]+(/[^/\u0000-\u001f\u007f]+)*$",
                "not": {
                  "pattern": "/\\.{1,2}(/|$)"
                }
              },
              "evidence_directory": {
                "anyOf": [
                  {
                    "const": ""
                  },
                  {
                    "type": "string",
                    "pattern": "^/run/hikyo-upgrade/[^/\u0000-\u001f\u007f]+(/[^/\u0000-\u001f\u007f]+)*$",
                    "not": {
                      "pattern": "/\\.{1,2}(/|$)"
                    }
                  }
                ]
              },
              "ciphertext_path": {
                "anyOf": [
                  {
                    "const": ""
                  },
                  {
                    "type": "string",
                    "pattern": "^/run/hikyo-upgrade/[^/\u0000-\u001f\u007f]+(/[^/\u0000-\u001f\u007f]+)*$",
                    "not": {
                      "pattern": "/\\.{1,2}(/|$)"
                    }
                  }
                ]
              },
              "operator_public_key_file": {
                "type": "string",
                "pattern": "^/run/hikyo-upgrade/[^/\u0000-\u001f\u007f]+(/[^/\u0000-\u001f\u007f]+)*$",
                "not": {
                  "pattern": "/\\.{1,2}(/|$)"
                }
              },
              "target_manifest_sha256": {
                "type": "string",
                "pattern": "^([0-9a-f]{64})?$"
              },
              "legacy_writers_stopped": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "evidence_directory": {
                      "const": ""
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ciphertext_path": {
                      "const": ""
                    }
                  }
                },
                "else": {
                  "properties": {
                    "ciphertext_path": {
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "legacy_writers_stopped": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "evidence_directory": {
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "upgradeStateAliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,29}[a-z0-9])?$"
          }
        }
      }
    }
  }
}
