{
  "name": "stable trust sync branches require stable-release app",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/release/sync-trust-*"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "creation"},
    {"type": "update"}
  ]
}
