{
  "name": "@hikyo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "description": "The Hikyo single-page application. Built by Vite into ../internal/webui/dist, embedded by the server binary under the `ui` build tag.",
  "scripts": {
    "dev": "vite",
    "prototype": "vite --mode prototype",
    "build": "vite build && node scripts/precompress.mjs ../internal/webui/dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test-storybook": "vitest run --project storybook",
    "test-storybook:light": "STORYBOOK_THEME=light vitest run --project storybook",
    "e2e": "pnpm run build && playwright test --project=desktop && playwright test --project=mobile",
    "e2e:install": "playwright install --with-deps chromium",
    "storybook": "pnpm run design:export && storybook dev -p 6006",
    "build-storybook": "pnpm run design:export && storybook build",
    "design:seed": "node scripts/design/tokens-seed.ts",
    "design:check": "node scripts/design/tokens-check.ts && node scripts/design/adherence-check.ts",
    "design:export": "pnpm run design:check && node scripts/design/export.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.102.0",
    "@tanstack/react-virtual": "3.14.10",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@open-pencil/cli": "0.14.0",
    "@open-pencil/mcp": "0.14.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/culori": "4.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "culori": "4.0.2",
    "happy-dom": "^20.11.6",
    "playwright": "1.62.1",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
