+    private static boolean isWailsHost(String host) {
+        return host != null && (host.equals(WAILS_HOST) || host.endsWith("." + WAILS_HOST));
+    }
+
+    /** Only web links and mailto leave the app; anything else is dropped. */
+    private void openExternal(Uri u) {
+        String scheme = u.getScheme();
+        if (!"http".equals(scheme) && !"https".equals(scheme) && !"mailto".equals(scheme)) return;
+        try {
+            startActivity(new Intent(Intent.ACTION_VIEW, u).addCategory(Intent.CATEGORY_BROWSABLE).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+        } catch (android.content.ActivityNotFoundException e) {
+            Log.w(TAG, "no app for " + scheme);
+        }
+    }
+
+    /** A request body reaches the app over a WebMessageListener restricted to this app's origins; spike-shim.js sends it. */
+    private void installBodyChannel() {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)
+                || !WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)
+                || !WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_ARRAY_BUFFER)) {
+            Log.e(TAG, "body channel unsupported by this WebView");
+            return;
+        }
+        java.util.Set<String> rules = new java.util.HashSet<>(java.util.Arrays.asList("https://" + WAILS_HOST, "https://*." + WAILS_HOST));
+        WebViewCompat.addWebMessageListener(webView, "spikeBodies", rules, (view, message, sourceOrigin, isMainFrame, reply) -> {
+            byte[] data = message.getType() == WebMessageCompat.TYPE_ARRAY_BUFFER ? message.getArrayBuffer() : null;
+            String id = data == null ? null : SpikeBridge.stash(sourceOrigin.toString(), data);
+            reply.postMessage(id == null ? "refused" : id);
+        });
+        try (InputStream in = getAssets().open("spike-shim.js")) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[8192];
+            for (int n; (n = in.read(buf)) > 0; ) out.write(buf, 0, n);
+            WebViewCompat.addDocumentStartJavaScript(webView, out.toString("UTF-8"), rules);
+        } catch (java.io.IOException e) {
+            Log.e(TAG, "shim unreadable", e);
+        }
+    }
+
+    /** The WebView cannot fetch a wails origin itself, so the file comes through the Go proxy into the app's download folder. */
+    private void saveDownload(String url, String disposition, String mime) {
+        new Thread(() -> {
+            String name = new File(android.webkit.URLUtil.guessFileName(url, disposition, mime)).getName().replaceAll("[^A-Za-z0-9._-]", "_");
+            if (name.length() > 100) name = name.substring(0, 100);
+            File dir = getExternalFilesDir(android.os.Environment.DIRECTORY_DOWNLOADS);
+            File out = new File(dir, name);
+            try {
+                long size = SpikeBridge.download(url, out);
+                Log.i(TAG, "download saved " + name + " " + size + " bytes");
+                runOnUiThread(() -> android.widget.Toast.makeText(this, "Saved " + out.getName(), android.widget.Toast.LENGTH_LONG).show());
+            } catch (Exception e) {
+                Log.e(TAG, "download failed", e);
+            }
+        }).start();
+    }
+
