{
  "format": "hikyo.security-maintenance-config/v1",
  "state_directory": "/var/lib/hikyo-security-maintenance",
  "status_file": "/var/lib/hikyo-security-status/status.json",
  "feed": {
    "metadata_url": "https://hikyo.app/security-feed/metadata/",
    "targets_url": "https://hikyo.app/security-feed/targets/",
    "root_file": "/etc/hikyo/security-feed-root.json"
  },
  "policy": {
    "mode": "automatic",
    "channel": "stable",
    "upgrade_class": "compatible",
    "allow_maintenance": true,
    "minimum_severity": "low",
    "window_start_minute": 0,
    "window_duration_minutes": 0,
    "urgent_severity": "critical"
  },
  "kind": "native",
  "native_config": "/etc/hikyo/upgrade.json",
  "timeout_seconds": 1800
}
