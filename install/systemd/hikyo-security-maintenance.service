[Unit]
Description=Hikyo local automatic security maintenance
Documentation=https://hikyo.app/docs/upgrades/
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/hikyo/security-maintenance.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/hikyo security-maintenance run --once
# The coordinator bounds its operations and owns migration recovery. systemd
# must not impose its default start timeout in the middle of a schema write.
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
