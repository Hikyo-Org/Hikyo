#!/bin/sh
set -eu

fail() { printf 'hikyo updater adapter: %s\n' "$*" >&2; exit 1; }
require_var() { eval "value=\${$1:-}"; [ -n "$value" ] || fail "$1 is required"; }
require_absolute() { require_var "$1"; eval "value=\${$1}"; [ "${value#/}" != "$value" ] || fail "$1 must be absolute"; }
require_bin() { require_absolute "$1"; eval "value=\${$1}"; [ -x "$value" ] || fail "$1 is not executable: $value"; }

validate_request() {
	phase=$1
	version=$2
	job_id=${3:-}
	printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || fail 'version must be stable SemVer'
	printf '%s' "$job_id" | grep -Eq '^upd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' || fail 'invalid job id'
	case "$phase" in plan|backup|verify|apply|health|rollback) ;; *) fail "unknown phase $phase" ;; esac
	require_absolute HIKYO_UPDATE_WORK_DIR
	job_dir="$HIKYO_UPDATE_WORK_DIR/$job_id"
	mkdir -p "$job_dir"
	chmod 0700 "$job_dir"
}

verify_release() {
	version=$1
	release_url=$2
	job_id=$3
	[ "$release_url" = "https://github.com/Hikyo-Org/hikyo/releases/tag/v$version" ] || fail 'release URL is outside the fixed Hikyo authority'
	require_bin HIKYO_GH_BIN
	require_bin HIKYO_CURL_BIN
	require_bin HIKYO_JQ_BIN
	require_bin HIKYO_VERIFY_BUNDLE_BIN
	require_absolute HIKYO_TRUST_ROOT
	require_absolute HIKYO_TRUST_STATE
	[ -f "$HIKYO_TRUST_ROOT" ] || fail "missing pinned trust root $HIKYO_TRUST_ROOT"

	bundle="$job_dir/bundle"
	trust="$job_dir/trust"
	rm -rf "$bundle" "$trust"
	mkdir -m 0700 "$bundle" "$trust"
	"$HIKYO_GH_BIN" release download "v$version" --repo Hikyo-Org/hikyo --dir "$bundle"
	base="https://raw.githubusercontent.com/Hikyo-Org/Hikyo/v$version/release/trust"
	"$HIKYO_CURL_BIN" --fail --silent --show-error --proto '=https' --tlsv1.2 "$base/metadata.json" -o "$trust/metadata.json"
	"$HIKYO_CURL_BIN" --fail --silent --show-error --proto '=https' --tlsv1.2 "$base/metadata.sigstore.json" -o "$trust/metadata.sigstore.json"
	"$HIKYO_JQ_BIN" -r '.primary_keys[].public_key, .recovery.public_key' "$trust/metadata.json" | while IFS= read -r key; do
		case "$key" in ''|*/*|*..*) fail "unsafe trust key name $key" ;; esac
		"$HIKYO_CURL_BIN" --fail --silent --show-error --proto '=https' --tlsv1.2 "$base/$key" -o "$trust/$key"
	done
	# The pinned root names its recovery/bootstrap keys; copy those immutable
	# local pins beside downloaded, signed metadata before verification.
	root_dir=$(CDPATH='' cd -- "$(dirname "$HIKYO_TRUST_ROOT")" && pwd)
	"$HIKYO_JQ_BIN" -r '.recovery.public_key, .bootstrap_primary.public_key' "$HIKYO_TRUST_ROOT" | while IFS= read -r key; do
		[ -f "$root_dir/$key" ] || fail "missing pinned public key $root_dir/$key"
		cp "$root_dir/$key" "$trust/$key"
	done
	cp "$HIKYO_TRUST_ROOT" "$trust/root.json"
	"$HIKYO_VERIFY_BUNDLE_BIN" --root "$trust/root.json" --metadata "$trust/metadata.json" \
		--metadata-signature "$trust/metadata.sigstore.json" --bundle "$bundle" \
		--state "$HIKYO_TRUST_STATE" --latest --published
	# $version below is a jq variable, not shell text.
	# shellcheck disable=SC2016
	"$HIKYO_JQ_BIN" -e --arg version "$version" '.version == $version' "$bundle/release-manifest.json" >/dev/null
}

backup_database() {
	require_bin HIKYO_BIN
	mkdir -p "$job_dir/backup"
	chmod 0700 "$job_dir/backup"
	HIKYO_BACKUP_DIR="$job_dir/backup" "$HIKYO_BIN" backup export --out "$job_dir/backup"
	set -- "$job_dir/backup"/*
	[ -f "$1" ] || fail 'backup export produced no archive'
}

restore_database() {
	require_bin HIKYO_ROLLBACK_BIN
	"$HIKYO_ROLLBACK_BIN" "$job_dir/backup" "$version" "$job_id"
}

health_check() {
	require_bin HIKYO_CURL_BIN
	require_var HIKYO_HEALTH_URL
	"$HIKYO_CURL_BIN" --fail --silent --show-error --max-time 10 "$HIKYO_HEALTH_URL" >/dev/null
}
