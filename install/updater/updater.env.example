# Root-owned, mode 0640, readable by the hikyo-updater group. Use absolute paths.
HIKYO_UPDATE_LIB=/usr/local/libexec/hikyo-update-common
HIKYO_UPDATE_WORK_DIR=/var/lib/hikyo-updater/work
HIKYO_BIN=/usr/local/bin/hikyo
HIKYO_ROLLBACK_BIN=/usr/local/libexec/hikyo-restore-preupdate-backup
HIKYO_CURL_BIN=/usr/bin/curl
HIKYO_GH_BIN=/usr/bin/gh
HIKYO_JQ_BIN=/usr/bin/jq
HIKYO_VERIFY_BUNDLE_BIN=/usr/local/libexec/hikyo-release/verify-bundle.sh
HIKYO_TRUST_ROOT=/etc/hikyo/release-trust/root.json
HIKYO_TRUST_STATE=/var/lib/hikyo-updater/trust-state.json
HIKYO_HEALTH_URL=http://127.0.0.1:8081/readyz
# Required by the encrypted pre-update export. Match the running instance.
HIKYO_DB=sqlite:/var/lib/hikyo/hikyo.db
HIKYO_BACKUP_RECIPIENTS=age1replace-with-an-authorized-backup-recipient

# Compose profile
HIKYO_DOCKER_BIN=/usr/bin/docker
HIKYO_COMPOSE_PROJECT_DIR=/srv/hikyo
HIKYO_COMPOSE_FILE=/srv/hikyo/compose.yaml
HIKYO_COMPOSE_ENV_FILE=/srv/hikyo/hikyo-image.env

# systemd profile
HIKYO_SYSTEMCTL_BIN=/usr/bin/systemctl
HIKYO_INSTALL_BIN=/usr/bin/install
HIKYO_TAR_BIN=/usr/bin/tar
HIKYO_BINARY_PATH=/usr/local/bin/hikyo
HIKYO_SYSTEMD_UNIT=hikyo.service

# Flux profile
HIKYO_GIT_BIN=/usr/bin/git
HIKYO_YQ_BIN=/usr/bin/yq
HIKYO_FLUX_BIN=/usr/local/bin/flux
HIKYO_FLUX_REPO=/srv/hikyo-gitops
HIKYO_FLUX_VALUES_FILE=/srv/hikyo-gitops/apps/hikyo/values.yaml
HIKYO_FLUX_KUSTOMIZATION=hikyo
